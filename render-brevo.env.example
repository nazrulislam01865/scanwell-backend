# Render -> ScanWell service -> Environment
APP_ENV=production
EMAIL_DRIVER=brevo
AUTH_EXPOSE_DEVELOPMENT_CODES=false

# Create this under Brevo -> SMTP & API -> API Keys.
BREVO_API_KEY=xkeysib-replace-with-your-real-api-key
BREVO_TIMEOUT_SECONDS=15

# This must match the sender email you verified in Brevo.
EMAIL_FROM_NAME=ScanWell
EMAIL_FROM_ADDRESS=your-verified-email@gmail.com
